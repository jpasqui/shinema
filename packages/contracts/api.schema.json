{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shinema API version 1",
  "$defs": {
    "Media": {
      "type": "object",
      "required": [
        "id",
        "title",
        "container",
        "sizeBytes",
        "streamPath"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Maximum 200 Unicode scalar values, matching Rust char counting."
        },
        "container": {
          "enum": [
            "mp4",
            "m4v",
            "mkv",
            "webm"
          ]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "streamPath": {
          "type": "string",
          "pattern": "^/api/media/[a-f0-9]{64}/stream$"
        }
      }
    },
    "Catalog": {
      "type": "object",
      "required": [
        "apiVersion",
        "items"
      ],
      "properties": {
        "apiVersion": {
          "const": 1
        },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/Media"
          }
        }
      }
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positionSeconds",
        "durationSeconds"
      ],
      "properties": {
        "positionSeconds": {
          "type": "number",
          "minimum": 0
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 604800
        }
      }
    }
  }
}
