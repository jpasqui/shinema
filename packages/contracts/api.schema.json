{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shinema API version 1",
  "$defs": {
    "Media": {
      "type": "object",
      "required": [
        "id",
        "title",
        "container",
        "sizeBytes",
        "streamPath"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Maximum 200 Unicode scalar values, matching Rust char counting."
        },
        "container": {
          "enum": [
            "mp4",
            "m4v",
            "mkv",
            "webm",
            "avi",
            "ts",
            "m2ts",
            "mov",
            "mpg",
            "mpeg",
            "wmv",
            "vob"
          ]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "streamPath": {
          "type": "string",
          "pattern": "^/api/media/[a-f0-9]{64}/stream$"
        },
        "collection": {
          "enum": [
            "tv",
            "movies"
          ]
        },
        "seriesId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "seriesTitle": {
          "type": "string",
          "maxLength": 200
        },
        "season": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "episode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "posterPath": {
          "type": "string",
          "pattern": "^/api/media/[a-f0-9]{64}/poster$"
        },
        "backdropPath": {
          "type": "string",
          "pattern": "^/api/media/[a-f0-9]{64}/backdrop$"
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "year": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "genres": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "fileTitle": {
          "type": "string",
          "maxLength": 200
        },
        "fileYear": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "metadataSource": {
          "enum": [
            "tmdb",
            "tvmaze"
          ]
        },
        "metadataUrl": {
          "type": "string",
          "maxLength": 200
        },
        "metadataExpiresAt": {
          "type": "integer",
          "minimum": 0
        },
        "libraryId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        }
      }
    },
    "Catalog": {
      "type": "object",
      "required": [
        "apiVersion",
        "items"
      ],
      "properties": {
        "apiVersion": {
          "const": 1
        },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/Media"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "nextOffset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000000
        },
        "fullLibrary": {
          "type": "boolean"
        },
        "metadataPending": {
          "type": "boolean"
        }
      }
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positionSeconds",
        "durationSeconds"
      ],
      "properties": {
        "positionSeconds": {
          "type": "number",
          "minimum": 0
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 604800
        }
      }
    },
    "Playback": {
      "type": "object",
      "required": [
        "durationSeconds",
        "mode",
        "streamPath"
      ],
      "properties": {
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 604800
        },
        "mode": {
          "enum": [
            "direct",
            "transcode"
          ]
        },
        "streamPath": {
          "type": "string",
          "pattern": "^/api/media/[a-f0-9]{64}/(stream|hls/index\\.m3u8)$"
        }
      }
    },
    "LibraryDescriptor": {
      "type": "object",
      "required": [
        "id",
        "name",
        "mediaType",
        "visible",
        "order"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "mediaType": {
          "enum": [
            "movies",
            "tv",
            "mixed"
          ]
        },
        "visible": {
          "type": "boolean"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "Libraries": {
      "type": "object",
      "required": [
        "version",
        "revision",
        "libraries"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "libraries": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/LibraryDescriptor"
          }
        }
      }
    },
    "LibraryConfiguration": {
      "allOf": [
        {
          "$ref": "#/$defs/LibraryDescriptor"
        },
        {
          "type": "object",
          "required": [
            "sourceFolders"
          ],
          "properties": {
            "sourceFolders": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "An approved relative folder selector, including . for the local source root; never an absolute path."
              }
            }
          }
        }
      ]
    },
    "TopNavigationDestination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "browse",
                "search",
                "settings"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "libraryId"
          ],
          "properties": {
            "kind": {
              "const": "library"
            },
            "libraryId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$"
            }
          }
        }
      ]
    },
    "TopNavigationPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "entries"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "entries": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "destination",
              "order",
              "visible"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "destination": {
                "$ref": "#/$defs/TopNavigationDestination"
              },
              "order": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "visible": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
