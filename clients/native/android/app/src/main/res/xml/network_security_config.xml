<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Runtime-selected LAN hostnames cannot be expressed as static domains.
       All app HTTP stacks use ShinemaNetwork's exact-origin/address guard.
       TLS retains platform/system certificate and hostname validation. -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors><certificates src="system" /></trust-anchors>
  </base-config>
</network-security-config>
